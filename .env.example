PORT=3000
CORS_ORIGIN=http://localhost:4173

# Optional: require Bearer auth for POST /astros/refresh and POST /ask.
# Leave empty for local/dev usage.
ADMIN_TOKEN=

# Ollama image-description model used by POST /ask.
MODEL=llava:13b

# Discord bot credentials for scraping Astro Sightings image uploads.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
ASTROS_LIMIT=100
