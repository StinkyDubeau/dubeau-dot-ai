PORT=3000
CORS_ORIGIN=http://localhost:4173

# Optional: require Bearer auth for POST /astros/refresh and POST /ask.
# Leave empty for local/dev usage.
ADMIN_TOKEN=

# Ollama image-description model used by POST /ask.
MODEL=llava:13b

# Discord bot credentials for scraping Astro Sightings image uploads.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
ASTROS_LIMIT=100

# Full Discord timeline sync. Set ASTRO_SYNC_LIMIT=0 to sync the entire channel.
ASTRO_SYNC_LIMIT=1000

# Local durable storage for normalized Discord timeline and curated sightings.
ASTRO_DATA_PATH=./data/astro-sightings.json
